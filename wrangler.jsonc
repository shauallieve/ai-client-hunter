{
  "name": "ai-client-hunter",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEAD_STORE",
        "class_name": "LeadStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "telegram-v1",
      "new_sqlite_classes": [
        "LeadStore"
      ]
    }
  ]
}
